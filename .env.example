# Copie para .env e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (recomendado em produção): chave do site reCAPTCHA v3 para o App Check.
# Veja a seção "Segurança" do README.
VITE_RECAPTCHA_SITE_KEY=
